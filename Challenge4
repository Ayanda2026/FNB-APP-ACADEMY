# The Smart ATM Withdrawal Simulator
balance = 500
withdrawal = float(input("How much would you like to withdraw? ")) 

if withdrawal <= 0:
    print("Invalid amount. You must withdraw more than R0. ")

elif withdrawal <= balance:
     balance = balance - withdrawal
     print("Withdreawal successful!") 
     print(f"remaining balance: R{balance}")

else:
     print("Declined. Insufficient funds")

